# Bu dosya şablondur, gerçek değer içermez. Kopyalayıp .env adıyla doldur.
# Gerçek .env dosyasını asla git'e ekleme.

# MySQL/MariaDB bağlantısı: mysql://KULLANICI:SIFRE@HOST:3306/VERITABANI
DATABASE_URL=

# En az 32 karakterlik rastgele bir değer. Production'da yerelden FARKLI olmalı.
JWT_SECRET=

PORT=5000

# Production'da sitenin adresi (virgülle birden fazla yazılabilir). Boşsa herkese açık.
CORS_ORIGIN=

# Kendi kendine kayıt kapalı (v1 gibi). Açmak için true yaz.
ALLOW_REGISTRATION=false

# Müşteri (user rolü) sınırı. Varsayılan 50.
MAX_USERS=50

# Fotoğraf yükleme (Cloudinary). Console > Settings > API Keys sayfasından:
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME   (< > işaretleri, tırnak ve boşluk olmadan)
CLOUDINARY_URL=
